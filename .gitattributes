# Auto detect text files and perform LF normalization
* text=auto

# assets/ and README.md are build output (src/ → npm run build)
assets/** linguist-generated=true
README.md linguist-generated=false

# Build output is regenerated by every build, and the nightly workflow
# commits it too. On a merge, keep our side instead of conflicting
# (needs, once per clone: git config merge.ours.driver true).
README.md merge=ours
assets/** merge=ours
src/data/contributions.json merge=ours
koi/** merge=ours
